{
  "name": "studia-app",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "tipos": "tsc --noEmit",
    "prueba:ui": "jest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "@supabase/supabase-js": "^2.112.4",
    "expo": "^57.0.16",
    "expo-audio": "^57.0.4",
    "expo-status-bar": "~3.0.0",
    "react": "19.2.8",
    "react-native": "0.87.0",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.27.0",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@react-native/assets-registry": "^0.87.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "expo-modules-core": "^57.0.13",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.4",
    "react-test-renderer": "^19.2.8",
    "typescript": "~5.9.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.prueba.tsx"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/pruebas/preparar.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ]
  }
}

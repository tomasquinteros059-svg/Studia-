{
  "name": "studia-app",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "tipos": "tsc --noEmit",
    "prueba:ui": "jest",
    "paquete": "expo export --platform android --output-dir .paquete-prueba",
    "paquete:android": "EXPO_NO_TELEMETRY=1 expo export --platform android"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.13",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "@supabase/supabase-js": "^2.112.4",
    "expo": "^57.0.16",
    "expo-audio": "~57.0.4",
    "expo-constants": "~57.0.14",
    "expo-document-picker": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-notifications": "~57.0.14",
    "expo-speech": "~57.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "^57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@react-native/assets-registry": "^0.87.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "babel-preset-expo": "^57.0.8",
    "expo-modules-core": "~57.0.13",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "react-test-renderer": "19.2.3",
    "typescript": "~5.9.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.prueba.tsx"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/pruebas/preparar.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ]
  }
}

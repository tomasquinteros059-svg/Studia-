{
  "expo": {
    "name": "Acta",
    "slug": "acta",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "acta",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#208AEF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.studia.app"
    },
    "android": {
      "package": "cl.studia.app",
      "resizeableActivity": true
    },
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": ""
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Acta usa el micrófono para grabar la reunión que tú empieces, y solo mientras la grabas.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": true
        }
      ],
      "expo-notifications"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}

{
  "expo": {
    "name": "StudIA",
    "slug": "studia",
    "version": "1.4.0",
    "orientation": "default",
    "scheme": "studia",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.studia.app",
      "icon": "./assets/icono.png"
    },
    "android": {
      "package": "cl.studia.app",
      "resizeableActivity": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icono-adaptativo.png",
        "monochromeImage": "./assets/icono-monocromo.png",
        "backgroundColor": "#2F45D4"
      }
    },
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": ""
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/arranque.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FBFAF5"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icono-monocromo.png",
          "color": "#2F45D4"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "StudIA usa el micrófono solo cuando pides la palabra en una clase en vivo.",
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "icon": "./assets/icono.png"
  }
}

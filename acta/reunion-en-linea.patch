+import { Linking } from "react-native";
+import { fireEvent, waitFor } from "@testing-library/react-native";
+import { COMPLETA, YO, renderPantalla } from "../../../pruebas/dobles.tsx";
+
+jest.mock("../../lib/consultas.ts", () => ({
+  reunionPorId: jest.fn(),
+  quienSoy: jest.fn(),
+  marcarTarea: jest.fn(),
+  agregarTarea: jest.fn(),
+  abrirSala: jest.fn(),
+  cerrarSala: jest.fn(),
+}));
+
+import * as consultas from "../../lib/consultas.ts";
+import Reunion from "./Reunion.tsx";
+
+const mock = consultas as jest.Mocked<typeof consultas>;
+
+const conReunion = (extra: Partial<typeof COMPLETA>) => {
+  mock.reunionPorId.mockResolvedValue({ ...COMPLETA, ...extra } as never);
+  mock.quienSoy.mockResolvedValue(YO as never);
+};
+
+const abrir = () => renderPantalla(Reunion, { reunionId: COMPLETA.id });
+
+beforeEach(() => {
+  jest.clearAllMocks();
+  jest.spyOn(Linking, "openURL").mockResolvedValue(true as never);
+});
+
+describe("entrar a una reunión en línea", () => {
+  test("una reunión sin grabar con enlace ofrece entrar, con el nombre del servicio", async () => {
+    conReunion({ estado: "borrador", enlace: "https://meet.google.com/abc-defg-hij" });
+    const t = await abrir();
+
+    await waitFor(() => expect(t.getByText("Entrar a Google Meet")).toBeTruthy());
+    // Y dice a dónde lleva, sin el https:// que no aporta.
+    expect(t.getByText("meet.google.com/abc-defg-hij")).toBeTruthy();
+  });
+
+  test("tocar el botón abre el enlace en la aplicación que corresponda", async () => {
+    conReunion({ estado: "borrador", enlace: "https://us02web.zoom.us/j/845123" });
+    const t = await abrir();
+
+    await waitFor(() => expect(t.getByText("Entrar a Zoom")).toBeTruthy());
+    fireEvent.press(t.getByLabelText("Entrar a Zoom"));
+    expect(Linking.openURL).toHaveBeenCalledWith("https://us02web.zoom.us/j/845123");
+  });
+
+  test("una reunión presencial no muestra nada de esto", async () => {
+    conReunion({ estado: "borrador", enlace: null });
+    const t = await abrir();
+
+    await waitFor(() => expect(t.getByText(/todavía no se graba/)).toBeTruthy());
+    expect(t.queryByText(/^Entrar a /)).toBeNull();
+  });
+
+  test("se dice que no se oye a los demás por el enlace, que es lo que se daría por supuesto", async () => {
+    conReunion({ estado: "borrador", enlace: "https://meet.google.com/abc-defg-hij" });
+    const t = await abrir();
+
+    await waitFor(() => expect(t.getByText(/no oye a los demás/)).toBeTruthy());
+  });
+
+  test("si la invitación venía entera, se guardó solo la dirección y se abre esa", async () => {
+    conReunion({
+      estado: "borrador",
+      enlace: "https://meet.google.com/xyz-mnop-qrs",
+    });
+    const t = await abrir();
+
+    await waitFor(() => expect(t.getByText("Entrar a Google Meet")).toBeTruthy());
+    fireEvent.press(t.getByLabelText("Entrar a Google Meet"));
+    expect(Linking.openURL).toHaveBeenCalledWith("https://meet.google.com/xyz-mnop-qrs");
+  });
+});

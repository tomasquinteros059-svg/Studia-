@@ -0,0 +1,77 @@
+import { Alert, Linking, Pressable, StyleSheet, Text, View } from "react-native";
+import { Icono } from "../../ui/Icono.tsx";
+import { FILETE, color, espacio, radio, tenue, tipo } from "../../ui/tema.ts";
+import { comoEntrar, comoSeVe, leerEnlace } from "../../dominio/enlace.ts";
+
+/**
+ * La reunión en línea: a dónde hay que entrar y el botón para hacerlo.
+ *
+ * Abre la aplicación que corresponda —Meet, Zoom, Teams— o el navegador si
+ * no está instalada. Acta no entra a la reunión por dentro: ni Android ni
+ * iOS dejan que una aplicación capture el audio de otra, así que lo que se
+ * grabe será lo que suene en la sala donde uno esté. Eso se dice acá abajo
+ * y no en una nota de la ayuda, porque es justo lo que alguien podría dar
+ * por supuesto y descubrir demasiado tarde.
+ */
+export default function EnLinea({ enlace }: { enlace: string | null }) {
+  const leido = enlace ? leerEnlace(enlace) : null;
+  if (!leido) return null;
+
+  const entrar = async () => {
+    try {
+      await Linking.openURL(leido.url);
+    } catch {
+      Alert.alert(
+        "No pude abrir el enlace",
+        "Cópialo y ábrelo en el navegador:\n\n" + leido.url,
+      );
+    }
+  };
+
+  return (
+    <View style={e.caja}>
+      <View style={e.fila}>
+        <View style={e.sello}>
+          <Icono nombre="enLinea" tamano={20} tono={color.marca} />
+        </View>
+        <View style={{ flex: 1, gap: 2 }}>
+          <Text style={e.titulo}>{leido.nombre}</Text>
+          <Text style={tipo.detalle} numberOfLines={1}>{comoSeVe(leido.url)}</Text>
+        </View>
+      </View>
+
+      <Pressable accessibilityRole="link" accessibilityLabel={comoEntrar(leido)}
+        onPress={() => void entrar()}
+        style={({ pressed }) => [e.boton, pressed ? { opacity: 0.85 } : null]}>
+        <Icono nombre="abrir" tamano={18} tono={color.sobreMarca} />
+        <Text style={e.botonTexto}>{comoEntrar(leido)}</Text>
+      </Pressable>
+
+      <Text style={e.aviso}>
+        Acta no oye a los demás por el enlace: graba lo que suene donde estás.
+        En una reunión en línea, deja el altavoz puesto.
+      </Text>
+    </View>
+  );
+}
+
+const e = StyleSheet.create({
+  caja: {
+    gap: espacio.m, padding: espacio.m,
+    backgroundColor: color.papel, borderRadius: radio.tarjeta,
+    borderWidth: FILETE, borderColor: color.borde,
+  },

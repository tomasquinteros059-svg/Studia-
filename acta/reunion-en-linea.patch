diff --git a/supabase/migrations/20260828000400_reunion_en_linea.sql b/supabase/migrations/20260828000400_reunion_en_linea.sql
new file mode 100644
index 0000000..a4bb21b
--- /dev/null
+++ b/supabase/migrations/20260828000400_reunion_en_linea.sql
@@ -0,0 +1,25 @@
+-- La reunión en línea: a dónde hay que entrar.
+--
+-- Es una columna y no una tabla porque una reunión tiene un enlace, no
+-- varios: el de Meet, el de Zoom o el de Teams por el que entra la gente.
+--
+-- Se guarda solo la dirección, ya extraída de la invitación. Guardar la
+-- invitación completa —con su párrafo de instrucciones, sus teléfonos de
+-- marcado y su aviso legal— sería guardar texto de otro sistema en una
+-- columna que dice ser un enlace, y al leerla nadie sabría qué esperar.
+
+alter table public.reuniones
+  add column enlace text;
+
+-- Que sea una dirección abrible y no cualquier texto. Sin esto, el día que
+-- alguien pegue la invitación entera la app intentaría abrirla como URL y
+-- fallaría en el aparato, que es el peor lugar donde descubrirlo.
+alter table public.reuniones
+  add constraint enlace_es_una_direccion
+  check (enlace is null or enlace ~ '^https?://[^[:space:]]+$');
+
+comment on column public.reuniones.enlace is
+  'La reunión en línea (Meet, Zoom, Teams). Null si es presencial. '
+  'Acta no graba a los participantes remotos: ni Android ni iOS dejan que '
+  'una aplicación capture el audio de otra, así que el micrófono solo oye '
+  'lo que suene en la sala. El enlace sirve para entrar, no para grabar.';

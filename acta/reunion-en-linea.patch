+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { comoEntrar, comoSeVe, leerEnlace, podar, servicioDe } from "./enlace.ts";
+
+const url = (t: string) => leerEnlace(t)?.url ?? null;
+
+// ── De qué servicio es ──────────────────────────────────────────────────
+
+test("reconoce los tres servicios que usa la gente", () => {
+  assert.equal(servicioDe("https://meet.google.com/abc-defg-hij"), "meet");
+  assert.equal(servicioDe("https://us02web.zoom.us/j/123456789"), "zoom");
+  assert.equal(servicioDe("https://teams.microsoft.com/l/meetup-join/19%3ameeting"), "teams");
+});
+
+test("un servicio que no conoce sigue sirviendo, solo que sin nombre", () => {
+  const e = leerEnlace("https://videollamada.miempresa.cl/sala/42");
+  assert.equal(e?.servicio, "otro");
+  assert.equal(comoEntrar(e!), "Entrar a la reunión");
+});
+
+test("un dominio que solo termina parecido no se hace pasar por el servicio", () => {
+  assert.equal(servicioDe("https://nozoom.us/j/1"), "otro");
+  assert.equal(servicioDe("https://meet.google.com.falso.cl/x"), "otro");
+  // Un subdominio de verdad sí cuenta.
+  assert.equal(servicioDe("https://us02web.zoom.us/j/1"), "zoom");
+});
+
+test("el puerto y el usuario no impiden reconocer el servicio", () => {
+  assert.equal(servicioDe("https://MEET.GOOGLE.COM/abc-defg-hij"), "meet");
+  assert.equal(servicioDe("https://zoom.us:443/j/123"), "zoom");
+});
+
+// ── Sacar el enlace de una invitación pegada ────────────────────────────
+
+test("una dirección sola se toma tal cual", () => {
+  assert.equal(url("https://meet.google.com/abc-defg-hij"), "https://meet.google.com/abc-defg-hij");
+  assert.equal(url("  https://zoom.us/j/123  "), "https://zoom.us/j/123");
+});
+
+test("de una invitación entera saca el enlace de la reunión, no el primero", () => {
+  const invitacion = `
+Reunión de comité
+Cuándo: martes 3, 10:00
+Ver en Google Calendar: https://calendar.google.com/calendar/event?eid=abc
+
+Información para unirse por videollamada
+Enlace: https://meet.google.com/xyz-mnop-qrs
+¿Más ayuda? https://support.google.com/a/users/answer/9282720
+`;
+  assert.equal(url(invitacion), "https://meet.google.com/xyz-mnop-qrs");
+});
+
+test("la puntuación de la frase no se queda pegada a la dirección", () => {
+  assert.equal(url("Entra a https://meet.google.com/abc-defg-hij."),
+    "https://meet.google.com/abc-defg-hij");
+  assert.equal(url("(https://zoom.us/j/123)"), "https://zoom.us/j/123");
+  assert.equal(url("El enlace es https://zoom.us/j/123, avisa si no entra."),
+    "https://zoom.us/j/123");
+});
+
+test("un paréntesis que es parte de la dirección no se poda", () => {
+  const t = "https://teams.microsoft.com/l/meetup-join/19%3ameeting_(NzQ)%40thread";
+  assert.equal(podar(t), t);
+});
+
+test("sin ninguna dirección no hay enlace, y eso no es un error", () => {
+  assert.equal(leerEnlace(""), null);
+  assert.equal(leerEnlace("   "), null);
+  assert.equal(leerEnlace("Reunión en la sala 3, presencial"), null);
+  // Sin http:// delante no es una dirección que se pueda abrir.
+  assert.equal(leerEnlace("meet.google.com/abc-defg-hij"), null);
+});
+
+test("el nombre del servicio es lo que se pinta en el botón", () => {
+  assert.equal(comoEntrar(leerEnlace("https://meet.google.com/a-b-c")!), "Entrar a Google Meet");
+  assert.equal(comoEntrar(leerEnlace("https://zoom.us/j/1")!), "Entrar a Zoom");
+  assert.equal(comoEntrar(leerEnlace("https://teams.microsoft.com/l/x")!),
+    "Entrar a Microsoft Teams");
+});
+
+// ── Cómo se muestra ─────────────────────────────────────────────────────
+
+test("la dirección se muestra sin el https:// que no aporta nada", () => {
+  assert.equal(comoSeVe("https://meet.google.com/abc-defg-hij"), "meet.google.com/abc-defg-hij");
+  assert.equal(comoSeVe("https://zoom.us/j/123/"), "zoom.us/j/123");
+});
+
+test("una dirección larguísima se corta en vez de ocupar tres renglones", () => {
+  const larga = `https://teams.microsoft.com/l/meetup-join/${"x".repeat(200)}`;
+  const vista = comoSeVe(larga);
+  assert.ok(vista.length <= 44, `mide ${vista.length}`);
+  assert.ok(vista.endsWith("…"));
+});

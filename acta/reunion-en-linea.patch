+// El enlace de la reunión en línea.
+//
+// Casi nadie escribe la dirección a mano: se pega la invitación entera del
+// calendario, con su párrafo de instrucciones, su número de teléfono y su
+// aviso legal. Sacar el enlace de ahí es todo el trabajo, y hacerlo bien es
+// la diferencia entre entrar de un toque y tener que buscar el correo.
+//
+// Lo que esto NO hace, y conviene que quede escrito: Acta no puede grabar a
+// los demás participantes de una reunión en línea. Ni Android ni iOS dejan
+// que una aplicación capture el audio de otra —el de una llamada, nunca—,
+// así que el micrófono solo oye lo que suene en la sala donde uno está. El
+// enlace sirve para entrar a la reunión, no para grabarla por dentro.
+
+export type Servicio = "meet" | "zoom" | "teams" | "otro";
+
+export type Enlace = {
+  url: string;
+  servicio: Servicio;
+  /** "Google Meet", "Zoom"… Lo que se pinta en el botón. */
+  nombre: string;
+};
+
+const NOMBRES: Record<Servicio, string> = {
+  meet: "Google Meet",
+  zoom: "Zoom",
+  teams: "Microsoft Teams",
+  otro: "la reunión",
+};
+
+/** Por dominio, que es lo único que no cambia de una invitación a otra. */
+const SERVICIOS: { servicio: Exclude<Servicio, "otro">; dominios: string[] }[] = [
+  { servicio: "meet", dominios: ["meet.google.com"] },
+  { servicio: "zoom", dominios: ["zoom.us", "zoom.com"] },
+  { servicio: "teams", dominios: ["teams.microsoft.com", "teams.live.com"] },
+];
+
+// Una dirección http(s) dentro de un texto cualquiera. Se corta en el primer
+// espacio o salto; los cierres pegados al final los limpia `podar`.
+const RE_URL = /https?:\/\/[^\s<>"']+/gi;
+
+/**
+ * Le saca a una dirección lo que se le pegó al final al copiarla: el punto
+ * de la frase, el paréntesis que la envolvía, la coma de la lista.
+ */
+export function podar(url: string): string {
+  let limpia = url.replace(/[.,;:!?]+$/, "");
+  // Un paréntesis de cierre solo sobra si no venía abierto adentro, como en
+  // ".../meetup-join/19%3ameeting_(algo)" — ahí es parte de la dirección.
+  while (/[)\]}>]$/.test(limpia)) {
+    const cierre = limpia.slice(-1);
+    const apertura = { ")": "(", "]": "[", "}": "{", ">": "<" }[cierre]!;
+    const abiertos = limpia.split(apertura).length - 1;
+    const cerrados = limpia.split(cierre).length - 1;
+    if (cerrados <= abiertos) break;
+    limpia = limpia.slice(0, -1);
+  }
+  return limpia;
+}
+
+/** A qué servicio pertenece una dirección. */
+export function servicioDe(url: string): Servicio {
+  const anfitrion = anfitrionDe(url);
+  if (!anfitrion) return "otro";
+  for (const { servicio, dominios } of SERVICIOS) {
+    // Con el punto delante para que "nozoom.us" no pase por Zoom.
+    if (dominios.some((d) => anfitrion === d || anfitrion.endsWith(`.${d}`))) {
+      return servicio;
+    }
+  }
+  return "otro";
+}
+
+function anfitrionDe(url: string): string | null {
+  const m = /^https?:\/\/([^/?#]+)/i.exec(url.trim());
+  if (!m?.[1]) return null;
+  // Sin usuario, sin puerto y en minúsculas: es lo que se compara.
+  return m[1].toLowerCase().replace(/^[^@]*@/, "").replace(/:\d+$/, "");
+}
+
+/**
+ * Saca el enlace de la reunión de un texto cualquiera: una dirección sola,
+ * o la invitación completa pegada del calendario.
+ *
+ * Si hay varias direcciones se queda con la de un servicio conocido, no con
+ * la primera: las invitaciones de Google traen antes el enlace de la propia
+ * agenda, y el de ayuda, y el de "más opciones de marcado".
+ */
+export function leerEnlace(texto: string): Enlace | null {
+  const encontradas = (texto.match(RE_URL) ?? []).map(podar).filter(Boolean);
+  if (encontradas.length === 0) return null;
+
+  const conocida = encontradas.find((u) => servicioDe(u) !== "otro");
+  const url = conocida ?? encontradas[0]!;
+  const servicio = servicioDe(url);
+  return { url, servicio, nombre: NOMBRES[servicio] };
+}
+
+/** Lo que dice el botón para entrar. */
+export const comoEntrar = (enlace: Enlace): string =>
+  enlace.servicio === "otro" ? "Entrar a la reunión" : `Entrar a ${enlace.nombre}`;
+
+/**
+ * La dirección como se muestra en pantalla: sin el "https://" ni la ristra
+ * de parámetros, que en un enlace de Teams ocupa tres renglones.
+ */
+export function comoSeVe(url: string, largo = 44): string {
+  const corta = url.replace(/^https?:\/\//i, "").replace(/\/$/, "");
+  return corta.length <= largo ? corta : `${corta.slice(0, largo - 1)}…`;
+}

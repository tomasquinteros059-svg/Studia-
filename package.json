{
  "name": "acta",
  "private": true,
  "description": "Acta — reuniones profesionales con un equipo que escucha, redacta y entiende de lo tuyo",
  "scripts": {
    "prueba": "node --experimental-strip-types --test 'app/src/dominio/*.prueba.ts' 'app/src/lib/*.prueba.ts' 'supabase/functions/_compartido/*.prueba.ts' 'herramientas/*.prueba.ts'",
    "generar": "node --experimental-strip-types herramientas/generar-rubros.ts",
    "prueba:bd": "./supabase/pruebas/correr.sh",
    "prueba:sintaxis": "node supabase/pruebas/sintaxis.mjs",
    "tipos": "npm --prefix app run tipos",
    "test": "npm run prueba",
    "prueba:ui": "npm --prefix app run prueba:ui",
    "prueba:todo": "npm run prueba && npm run prueba:ui && npm run prueba:sintaxis && npm run tipos && npm run prueba:paquete && npm run prueba:bd",
    "prueba:paquete": "npm --prefix app run paquete"
  },
  "engines": {
    "node": ">=22.6"
  }
}
